{
  "name": "dsh-zentao-ai-workbench",
  "version": "0.1.3",
  "description": "DeepSeek Harness（DSH）禅道 AI 工作台：输入禅道链接取 Bug 列表，多选后交给已有/新会话，AI 处理完直接回写备注与状态。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lb290/dsh-zentao-ai-workbench.git"
  },
  "homepage": "https://github.com/lb290/dsh-zentao-ai-workbench#readme",
  "bugs": {
    "url": "https://github.com/lb290/dsh-zentao-ai-workbench/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "assets/icon-180.png",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "zentao",
    "禅道"
  ]
}
